rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // All authenticated team members can read the shared documentation.
    match /{document=**} {
      allow read: if signedIn();
    }

    match /users/{uid} {
      allow create, update: if isOwner(uid);
      allow delete: if false;
    }

    match /practices/{practiceId} {
      allow create, update: if signedIn();
      // A practice must be explicitly marked as deleting before its document
      // can be removed. The client marks it first, removes all child logs,
      // then deletes the parent document.
      allow delete: if signedIn() && resource.data.deleting == true;

      match /logs/{uid} {
        allow create, update: if isOwner(uid);
        // A member may delete their own log. During a confirmed practice
        // deletion, the cleanup routine may delete every child log.
        allow delete: if isOwner(uid) ||
          (signedIn() &&
           get(/databases/$(database)/documents/practices/$(practiceId)).data.deleting == true);
      }
    }
  }
}
