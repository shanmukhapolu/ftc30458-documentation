rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function practiceExists(practiceId) {
      return exists(/databases/$(database)/documents/practices/$(practiceId));
    }
    function practiceStarted(practiceId) {
      let practice = get(/databases/$(database)/documents/practices/$(practiceId));
      return practice.data.get("startAtMs", 0) <= request.time.toMillis();
    }
    match /{document=**} { allow read: if signedIn(); }
    match /users/{uid} {
      allow create, update: if isOwner(uid);
      allow delete: if false;
    }
    match /practices/{practiceId} {
      allow create, update: if signedIn();
      allow delete: if signedIn() && resource.data.deleting == true;
      match /logs/{uid} {
        allow create, update: if isOwner(uid) && practiceStarted(practiceId);
        allow delete: if isOwner(uid) || (signedIn() && get(/databases/$(database)/documents/practices/$(practiceId)).data.deleting == true);
      }
      match /attendance/{uid} {
        allow create, update: if isOwner(uid);
        allow delete: if isOwner(uid) || (signedIn() && get(/databases/$(database)/documents/practices/$(practiceId)).data.deleting == true);
      }
      match /documentSections/{sectionId} {
        allow create, update: if signedIn() && practiceExists(practiceId) && practiceStarted(practiceId);
        allow delete: if signedIn() && get(/databases/$(database)/documents/practices/$(practiceId)).data.deleting == true;
      }
      match /documentItems/{itemId} {
        allow create, update: if signedIn() && practiceExists(practiceId) && practiceStarted(practiceId);
        allow delete: if signedIn() && practiceStarted(practiceId);
      }
      match /documentMeta/{metaId} {
        allow create, update: if signedIn() && practiceExists(practiceId) && practiceStarted(practiceId);
        allow delete: if signedIn() && get(/databases/$(database)/documents/practices/$(practiceId)).data.deleting == true;
      }
      match /documentHistory/{entryId} {
        allow create: if signedIn() && practiceExists(practiceId) && practiceStarted(practiceId);
        allow update, delete: if signedIn() && get(/databases/$(database)/documents/practices/$(practiceId)).data.deleting == true;
      }
    }
  }
}